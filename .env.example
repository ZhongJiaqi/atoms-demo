# Atoms Demo 独立环境配置；不要在运行时读取其他项目的 .env。
# 本地可把 ai-news-radar 中已验证的对应值复制到本项目 .env.local。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3.8-flash

# Supabase Connect 面板中的项目 URL 与 publishable key。
# 浏览器和服务端均使用当前用户 Cookie + RLS；不要在前端配置 secret/service_role key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：线上独立预览 Origin，{projectId} 会替换为项目 UUID。
# 生产环境需要通配符 DNS，例如 https://{projectId}.preview.example.com
PREVIEW_PUBLIC_ORIGIN=
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000

# 线上远程 Sandbox 与静态预览发布接入后使用。
# Vercel 生产环境会自动提供 Sandbox OIDC；REST Deployment 仍需服务端 Token。
VERCEL_TOKEN=
VERCEL_TEAM_ID=
PREVIEW_VERCEL_PROJECT_ID=

# 仅用于本地真实 Playwright 验收，不要配置到 Vercel Production。
E2E_PRIMARY_EMAIL=
E2E_PRIMARY_PASSWORD=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
E2E_SIGNUP_EMAIL=
E2E_SIGNUP_PASSWORD=
