{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sandbox-template"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/auth/auth-boundaries.test.ts tests/agent/source-paths.test.ts tests/persistence/project-store.test.ts tests/persistence/restore-version.test.ts tests/persistence/sandbox-restore.test.ts tests/persistence/schema.test.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:representative": "playwright test tests/e2e/representative-apps.spec.ts",
    "test:e2e:phase2": "playwright test tests/e2e/phase2-auth-persistence.spec.ts",
    "test:e2e:rollback": "playwright test tests/e2e/version-rollback.spec.ts",
    "sandbox:dev": "node scripts/start-sandbox.mjs",
    "sandbox:build": "npm run build --workspace @atoms-demo/vite-example"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "15.5.27",
    "openai": "^6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3"
  }
}
